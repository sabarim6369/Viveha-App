{
  "expo": {
    "name": "Viveha",
    "slug": "viveha-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo2.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splashimg.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "This app needs access to your contacts to help you select customers when creating invoices."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/finallogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.isaiiai.vivehaaiapp",
      "permissions": [
        "READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d0ce4ead-b03e-45ea-8c26-241042e64bb4"
      }
    },
    "owner": "isaii",
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Viveha to save invoices to your photos.",
          "savePhotosPermission": "Allow Viveha to save invoices to your photos.",
          "isAccessMediaLocationEnabled": true,
          "writeOnly": true
        }
      ],
      "expo-asset"
    ]
  }
}
