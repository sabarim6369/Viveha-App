{
  "name": "viveka-backend",
  "version": "1.0.0",
  "description": "Viveka - B2B Billing System Backend API (Express + MongoDB)",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "node --loader ts-node/esm index.ts",
    "dev": "nodemon --exec node --loader ts-node/esm index.ts",
    "test": "node --loader ts-node/esm tests/test.ts",
    "test:watch": "nodemon --exec node --loader ts-node/esm tests/test.ts",
    "build": "tsc",
    "start:prod": "node dist/index.js"
  },
  "keywords": [
    "billing",
    "b2b",
    "invoicing",
    "viveka",
    "api"
  ],
  "author": "Viveka Team <dev@viveka.example>",
  "license": "MIT",
  "dependencies": {
    "@types/multer": "^2.1.0",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "chalk": "^5.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
